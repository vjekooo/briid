---
interface Props {
  slug: string
}

const { slug } = Astro.props

// Fetch page data using Contentful
import { contentfulClient, type Page } from '../lib/contentful'

const pageResponse = await contentfulClient.getEntries({
  content_type: 'page',
  'fields.slug': slug,
  limit: 1,
})

const pageEntry = pageResponse.items[0]

if (!pageEntry) {
  return Astro.redirect('/404')
}

const pageData = {
  title: pageEntry.fields.title,
  slug: pageEntry.fields.slug,
}
---

{pageData ? (
<div>
  <h1>{pageData.title}</h1>
  {/* Render your page content */}
</div>
    ) : (
<div>Page not found</div>
    )}