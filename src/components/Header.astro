---
interface Props {
  mobileLinks?: {
    title: string
    url: string
  }[]
}

const { mobileLinks } = Astro.props
---

<nav class="mt-0 flex w-full flex-wrap items-center justify-between px-6 py-6">
  <div class="block cursor-pointer md:hidden" id="menu-toggle">
    <svg
      class="fill-current text-gray-900"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 20 20"
    >
      <title>menu</title>
      <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
    </svg>
  </div>

  <div class="borders-solid order-1 border-b-2 border-gray-300 md:order-2">
    <a
      class="flex items-center text-3xl font-bold tracking-wide text-gray-800 no-underline hover:no-underline"
      href="/"
    >
      BRIID
    </a>
  </div>

  <div
    id="mobile-menu"
    class="absolute top-0 left-0 z-50 hidden h-[100vh] w-[90vw] bg-white p-4 shadow-lg transition-all duration-300 ease-in-out md:hidden"
  >
    <div class="flex justify-end">
      <svg
        class="cursor-pointer fill-current text-gray-900"
        id="menu-close"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 20 20"
      >
        <title>close</title>
        <path
          d="M10 8.586L2.929 1.515 1.515 2.929 8.586 10l-7.071 7.071 1.414 1.414L10 11.414l7.071 7.071 1.414-1.414L11.414 10l7.071-7.071-1.414-1.414L10 8.586z"
        ></path>
      </svg>
    </div>
    <ul class="flex flex-col space-y-6">
      <li>
        <a href="/" class="text-gray-800 hover:text-gray-600"> Home </a>
      </li>
      {
        mobileLinks?.map((link) => (
          <li>
            <a href={link.url} class="text-gray-800 hover:text-gray-600">
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  const menuClose = document.getElementById('menu-close')

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden')
    document.body.style.overflow = mobileMenu?.classList.contains('hidden')
      ? 'unset'
      : 'hidden'
  })

  menuClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden')
    document.body.style.overflow = 'unset'
  })
</script>
