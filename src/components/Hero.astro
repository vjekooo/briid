---
import HeroSlider, { type HeroItem } from './HeroSlider'

interface Props {
  items: HeroItem[]
  interval?: number
}

const { items, interval = 5000 } = Astro.props
---

<section
  class="bg-nordic-gray-light relative mx-auto flex w-full items-end overflow-hidden bg-cover bg-right md:pt-0"
  style="height: 32rem;"
  id="hero-section"
>
  <HeroSlider client:load items={items} interval={interval} />
</section>
