---
export interface CardArticle {
  title: string
  date: string
  url: string
  image: string
  readingTime: string
}

interface Props {
  article: CardArticle
}

const { article } = Astro.props

console.log(article)

const formatDate = (date: string) => {
  return new Date(date)
      .toLocaleDateString('en-GB', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      })
      .replace(/\//g, '.')
}
---

<div class="w-full flex flex-col">
  <a href={article.url}>
    <img class="hover:grow hover:shadow-lg" src={article.image} alt={article.title} />
    <div class="flex flex-col">
      <p class="pt-1 text-gray-900 h5 min-h-[52px]">{article.title}</p>
      <p class="pt-1 text-gray-800 line-clamp-2 text-sm">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
        eiusmod tempor incididunt ut labore et dolore magna aliqua
      </p>
    </div>
    <div class="flex items-center justify-between mt-5">
      <p class="text-gray-600 text-sm">{formatDate(article.date)}</p>
      <p class="text-gray-600 text-sm">
        {`${article.readingTime} min` || '5 min'}
      </p>
    </div>
  </a>
</div>
