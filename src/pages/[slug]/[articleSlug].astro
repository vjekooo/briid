---
import type { GetStaticPaths } from 'astro'
import {
  type ArticleSkeleton,
  type PageSkeleton,
  contentfulClient,
  type Article,
} from '../../lib/contentful'

import '../../styles/global.css'
import { createRenderOptions } from '../../utils/contentful'
import { documentToHtmlString } from '@contentful/rich-text-html-renderer'
import type { Asset, Entry } from 'contentful'
import Header from '../../components/Header.astro'
import Author from '../../components/Author.astro'
import Footer from '../../components/Footer.astro'

export const getStaticPaths: GetStaticPaths = async () => {
  const articleResponse = await contentfulClient.getEntries<ArticleSkeleton>({
    content_type: 'article',
    include: 2,
    limit: 1000,
  })

  return articleResponse.items
    .filter((entry) => entry.fields.page)
    .map((entry) => {
      const page = entry.fields.page as any as Entry<PageSkeleton>
      return {
        params: {
          slug: page.fields.slug as string,
          articleSlug: entry.fields.slug as string,
        },
        props: { articleEntry: entry.fields },
      }
    })
}

const { articleEntry } = Astro.props as { articleEntry: Article }

const article = {
  title: articleEntry.title,
  slug: articleEntry.slug,
  date: articleEntry.date,
  description: articleEntry.description,
  image: articleEntry.image as Asset | undefined,
  author: articleEntry.author,
  text: articleEntry.text,
  readingTime: articleEntry.readingTime,
}

const richTextHtml = article.text
  ? documentToHtmlString(article.text, createRenderOptions())
  : ''

const image = article.image as Asset | undefined
const fileUrl = image?.fields.file?.url

const imageUrl =
  typeof fileUrl === 'string'
    ? fileUrl.startsWith('//')
      ? `https:${fileUrl}`
      : fileUrl
    : undefined

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href

const formattedDate = article.date
  ? new Date(article.date).toISOString()
  : undefined

const metaDescription = article.description || article.title

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: metaDescription,
  url: canonicalUrl,
  ...(imageUrl ? { image: imageUrl } : {}),
  ...(formattedDate ? { datePublished: formattedDate } : {}),
  ...(article.author
    ? { author: { '@type': 'Person', name: article.author } }
    : {}),
  publisher: {
    '@type': 'Organization',
    name: 'BRIID',
  },
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{article.title} | BRIID</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {
      formattedDate && (
        <meta property="article:published_time" content={formattedDate} />
      )
    }

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={imageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={article.title} />
    <meta name="twitter:description" content={metaDescription} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <section class="bg-white">
      <Header />
      {
        imageUrl && (
          <div class="w-full">
            <img
              src={imageUrl}
              alt={article.title}
              class="h-auto w-full"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div class="container mx-auto flex flex-wrap items-center pt-4 pb-12">
        <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-[70%_30%]">
          <div class="flex flex-col gap-4 px-6">
            <h1 class="h1 font-bold">{article.title}</h1>
            {
              article.date && (
                <time datetime={formattedDate} class="text-sm text-gray-500">
                  {new Date(article.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              )
            }
            {article.author && <Author author={article.author} />}
            <div set:html={richTextHtml} />
          </div>
        </div>
      </div>
      <Footer />
    </section>
  </body>
</html>
