---
import {
  type ArticleSkeleton,
  contentfulClient,
  type PageSkeleton,
} from '../../lib/contentful'
import Header from '../../components/Header.astro'
import Author from '../../components/Author.astro'
import Footer from '../../components/Footer.astro'

import '../../styles/global.css'
import { createRenderOptions } from '../../utils/contentful'
import { documentToHtmlString } from '@contentful/rich-text-html-renderer'
import type { Asset } from 'contentful'

interface Props {
  slug: string
  articleSlug: string
}

export async function getStaticPaths() {
  const pagesResponse = await contentfulClient.getEntries<PageSkeleton>({
    content_type: 'page',
    order: ['fields.position'],
  })

  return pagesResponse.items.flatMap((page: any) =>
    (page.fields.articles || []).map((article: any) => ({
      params: {
        slug: page.fields.slug,
        articleSlug: article.fields.slug,
      },
      props: {
        slug: article.fields.slug,
        pageSlug: page.fields.slug,
      },
    }))
  )
}

const { slug, articleSlug } = Astro.props as Props

const articleResponse = await contentfulClient.getEntries<ArticleSkeleton>({
  content_type: 'article',
  'fields.slug': articleSlug,
  limit: 1,
})

const articleEntry = articleResponse.items[0]

if (!articleEntry) {
  return Astro.redirect('/404')
}

const article = {
  title: articleEntry.fields.title,
  slug: articleEntry.fields.slug,
  date: articleEntry.fields.date,
  image: articleEntry.fields.image as Asset | undefined,
  author: articleEntry.fields.author,
  text: articleEntry.fields.text,
  readingTime: articleEntry.fields.readingTime,
}

const richTextHtml = article.text
  ? documentToHtmlString(article.text, createRenderOptions())
  : ''

const image = article.image as Asset | undefined
const fileUrl = image?.fields.file?.url

const imageUrl =
  typeof fileUrl === 'string'
    ? fileUrl.startsWith('//')
      ? `https:${fileUrl}`
      : fileUrl
    : undefined
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BRIID - {article.title}</title>
    <meta name="description" content={article.title} />
  </head>
  <body>
    <section class="bg-white">
      <Header client:load />
      <div class="container mx-auto flex flex-wrap items-center pt-4 pb-12">
        <div class="grid w-full grid-cols-1 gap-4 md:grid-cols-[70%_30%]">
          <div class="flex flex-col gap-4 px-6">
            {
              imageUrl && (
                <div class="w-full">
                  <img
                    src={imageUrl}
                    alt={article.title}
                    class="h-auto w-full"
                  />
                </div>
              )
            }
            {article.author && <Author author={article.author} client:load />}
            <div set:html={richTextHtml} />
          </div>
        </div>
      </div>
      <Footer />
    </section>
  </body>
</html>
