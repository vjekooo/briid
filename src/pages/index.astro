---
import Card from '../components/Card.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import TextCard from '../components/TextCard.astro'
import {
  type ArticleSkeleton,
  contentfulClient,
  type PageSkeleton,
} from '../lib/contentful'

import '../styles/global.css'

const pagesResponse = await contentfulClient.getEntries<PageSkeleton>({
  content_type: 'page',
  order: ['fields.position'],
})

const pages = pagesResponse.items.map((item: any) => ({
  slug: item.fields.slug,
  title: item.fields.title,
  position: item.fields.position,
  articles: item.fields.articles || [],
}))

const featuredResponse = await contentfulClient.getEntries<ArticleSkeleton>({
  content_type: 'article',
  limit: 3,
  order: ['-fields.date'],
})

const featuredArticles = featuredResponse.items.map((item: any) => ({
  slug: item.fields.slug,
  title: item.fields.title,
  date: item.fields.date,
  image: item.fields.image,
  page: item.fields.page,
  readingTime: item.fields.readingTime,
}))

const mostReadResponse = await contentfulClient.getEntries<ArticleSkeleton>({
  content_type: 'article',
  limit: 3,
  order: ['-fields.views'],
})

const mostReadArticles = mostReadResponse.items.map((item: any) => ({
  slug: item.fields.slug,
  title: item.fields.title,
  date: item.fields.date,
  image: item.fields.image,
  readingTime: item.fields.readingTime,
  page: item.fields.page,
  views: item.fields.views,
}))

const heroArticles = featuredArticles.map((article) => ({
  title: article.title,
  url: `/${article.page.fields.slug}/${article.slug}`,
  date: article.date,
  image: article.image?.fields?.file?.url?.startsWith('//')
    ? `https:${article.image.fields.file.url}`
    : article.image?.fields?.file?.url || '',
}))

const mobileLinks = pages.map((page) => ({
  title: page.title,
  url: page.slug,
}))
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BRIID - Your Premier Source for Industry News and Insights</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Abel&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <meta
      name="description"
      content="Stay updated with the latest industry news, featured articles, and expert insights on BRIID. Discover trending topics and in-depth analysis."
    />
    <meta
      name="keywords"
      content="industry news, insights, articles, analysis, BRIID"
    />
    <meta property="og:title" content="BRIID - Industry News and Insights" />
    <meta
      property="og:description"
      content="Stay updated with the latest industry news, featured articles, and expert insights."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://briid.magazine.com" />
    {
      featuredArticles[0]?.image?.fields?.file?.url && (
        <meta
          property="og:image"
          content={`https:${featuredArticles[0].image.fields.file.url}`}
        />
      )
    }
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://briid.magazine.com" />
  </head>
  <body>
    <main>
      <div
        class="carousel relative container mx-auto flex flex-wrap items-center"
        style={{ maxWidth: '1600px' }}
      >
        <Header mobileLinks={mobileLinks} client:load />
        <div class="w-full">
          <Hero items={heroArticles} client:load />
        </div>
      </div>

      <section class="hidden bg-white md:block">
        <div class="container mx-auto pt-4">
          <div class="top-0 flex w-full gap-3 px-6 py-12">
            {
              pages.map((page, index) => (
                <div class="">
                  <a href={page.slug} class="h5 text-3xl uppercase">
                    {page.title} {index === pages.length - 1 ? '' : '/'}
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-white py-4">
        <div class="container mx-auto pt-4">
          <div class="top-0 px-6 py-1 md:w-2/3">
            <div
              class="container mx-auto mt-0 flex w-full items-center justify-between py-4"
            >
              <div
                class="h5 text-xl tracking-wide text-gray-800 uppercase no-underline hover:no-underline"
              >
                Najčitanije
              </div>
            </div>
            <div
              class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
            >
              {
                mostReadArticles?.map((article: any) => (
                  <TextCard
                    article={{
                      title: article.title,
                      url: `/${article.page.fields.slug}/${article.slug}`,
                      date: article.date,
                      image: article.image?.fields?.file?.url?.startsWith('//')
                        ? `https:${article.image.fields.file.url}`
                        : article.image?.fields?.file?.url || '',
                      readingTime: article.readingTime,
                    }}
                    client:load
                  />
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="bg-white">
        <div class="container mx-auto pt-4 pb-12">
          <div class="top-0 flex w-full flex-col gap-3 px-6 py-1">
            {
              pages.map((page) => (
                <div class="flex w-full flex-col">
                  <div class="container mx-auto mt-0 flex w-full items-center justify-between py-4">
                    <div class="h5 text-3xl tracking-wide text-gray-800 uppercase no-underline hover:no-underline">
                      <a href={page.slug}>{page.title}</a>
                    </div>
                  </div>
                  <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {page?.articles?.map((article: any) => (
                      <Card
                        article={{
                          title: article.fields.title,
                          url: `${page.slug}/${article.fields.slug}`,
                          date: article.fields.date,
                          image:
                            article.fields.image?.fields?.file?.url?.startsWith(
                              '//'
                            )
                              ? `https:${article.fields.image.fields.file.url}`
                              : article.fields.image?.fields?.file?.url || '',
                          readingTime: article.fields.readingTime,
                        }}
                        client:load
                      />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <Footer />
    </main>
  </body>
</html>
